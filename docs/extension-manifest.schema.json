{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lima extension manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "commands"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "trust": { "type": "string", "enum": ["bundled", "builtIn", "userInstalled", "unsigned"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["network", "shell", "filesystem", "clipboard", "selectedText", "accessibility", "processControl"] }
    },
    "commands": { "type": "array", "items": { "type": "object" } }
  }
}
