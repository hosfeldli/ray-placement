{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.liamhosfeld.com/docs/extension-manifest.schema.json",
  "title": "Lima extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "pack": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "bundled": {
      "type": "boolean"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "bundled",
        "userInstalled",
        "unsigned"
      ]
    },
    "trust": {
      "type": "string",
      "enum": [
        "bundled",
        "builtIn",
        "userInstalled",
        "unsigned"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "network",
          "shell",
          "filesystem",
          "clipboard",
          "selectedText",
          "accessibility",
          "processControl",
          "systemControl",
          "externalExecution"
        ]
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "type": "string"
        },
        "hotkey": {
          "type": "string"
        },
        "runInBackground": {
          "type": "boolean"
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "application",
            "clipboard",
            "file",
            "form",
            "picker",
            "shell",
            "system",
            "url",
            "window",
            "workspace"
          ]
        },
        "value": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "confirmation": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": "string"
        },
        "form": {
          "$ref": "#/$defs/form"
        },
        "chain": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "execution"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "submitLabel": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "secure",
            "multiline",
            "number",
            "toggle",
            "picker",
            "file",
            "directory",
            "date",
            "slider",
            "keyValue"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "defaultValue": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "section": {
          "type": "string"
        },
        "helpText": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "visibleWhen": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "equals": {
          "type": "string"
        },
        "notEquals": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "notEquals"
          ]
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "shell"
        },
        "executable": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
