{
  "schemaVersion": 2,
  "id": "local.example.line-count",
  "name": "Line Count",
  "version": "1.0.0",
  "description": "A local-only example that counts lines in a selected file.",
  "capabilities": [
    "shell",
    "filesystem",
    "externalExecution"
  ],
  "commands": [
    {
      "id": "count-lines",
      "title": "Count Lines",
      "subtitle": "Count lines in a selected file",
      "keywords": ["lines", "file", "text", "count"],
      "icon": "text.alignleft",
      "action": {
        "type": "form",
        "value": "",
        "form": {
          "title": "Count Lines",
          "submitLabel": "Count",
          "fields": [
            {
              "id": "inputFile",
              "label": "File",
              "type": "file",
              "required": true,
              "section": "Input"
            }
          ],
          "execution": {
            "type": "shell",
            "executable": "/usr/bin/wc",
            "arguments": ["-l", "{{inputFile}}"],
            "timeoutSeconds": 20
          }
        }
      }
    }
  ]
}
