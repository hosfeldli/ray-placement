{
  "manifest_version": 2,
  "name": "Lima Browser Bridge",
  "version": "1.1.0",
  "description": "Explicit per-site browser context for Lima. No automatic page access.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lima-browser-bridge@liamhosfeld.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "storage"
  ],
  "optional_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "policy.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Lima Browser Bridge",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
