{
  "schemaVersion": 2,
  "id": "local.endpoint-tester",
  "name": "Endpoint Tester",
  "version": "2.0.0",
  "description": "Build, send, and inspect HTTP requests in a Postman-style native workspace.",
  "commands": [
    {
      "id": "request",
      "title": "Test an HTTP Endpoint",
      "subtitle": "Params, auth, headers, bodies, history, cURL, and response inspection",
      "keywords": ["api", "http", "endpoint", "request", "rest", "test", "json", "postman", "curl"],
      "icon": "network",
      "action": {
        "type": "form",
        "value": "",
        "form": {
          "title": "Endpoint Tester",
          "submitLabel": "Send Request",
          "fields": [
            {
              "id": "method",
              "label": "Method",
              "type": "picker",
              "defaultValue": "GET",
              "options": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
            },
            {
              "id": "url",
              "label": "Endpoint",
              "type": "text",
              "placeholder": "https://api.example.com/health",
              "required": true
            },
            {
              "id": "authorization",
              "label": "Authorization header",
              "type": "secure",
              "placeholder": "Bearer …"
            },
            {
              "id": "contentType",
              "label": "Content-Type",
              "type": "picker",
              "defaultValue": "application/json",
              "options": ["application/json", "text/plain", "application/xml"]
            },
            {
              "id": "body",
              "label": "Request body",
              "type": "multiline",
              "placeholder": "{\n  \"key\": \"value\"\n}"
            }
          ],
          "execution": {
            "type": "httpRequest",
            "method": "{{method}}",
            "url": "{{url}}",
            "headers": {
              "Authorization": "{{authorization}}",
              "Content-Type": "{{contentType}}"
            },
            "body": "{{body}}",
            "timeoutSeconds": 30
          }
        }
      }
    }
  ]
}
